{
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "eject": "expo eject",
    "test": "jest --watchAll",
    "debug": "open 'rndebugger://set-debugger-loc?host=localhost&port=19000'",
    "lint": "npx eslint src/*"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.5",
    "@reduxjs/toolkit": "^2.9.0",
    "camelize-ts": "^2.2.0",
    "chroma-js": "^2.4.2",
    "expo": "^57.0.0",
    "expo-font": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.0.0",
    "formik": "^2.2.9",
    "keygenerator": "^1.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0",
    "yup": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.0",
    "@types/chroma-js": "^2.1.5",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "eslint-config-universe": "^11.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^2.8.7",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react-redux$": "<rootDir>/node_modules/react-redux/dist/cjs/index.js",
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js"
    }
  },
  "eslintConfig": {
    "extends": "universe/native"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "name": "packplanner",
  "version": "1.0.0"
}
