{
  "expo": {
    "name": "Trail Pack Pro",
    "slug": "packplanner",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/packplannerlogo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zachrmccoy.packplanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/packplannerlogo.png",
        "backgroundColor": "#4f5d75"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "description": "",
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/packplannerlogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#4f5d75"
        }
      ]
    ]
  }
}
